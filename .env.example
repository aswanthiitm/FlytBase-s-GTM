# --- LLM (Groq) -----------------------------------------------------------
# Get a key at https://console.groq.com/keys — it starts with gsk_
# Set it interactively (hidden input, never echoed):
#   uv run python -m gtm setkey
GROQ_API_KEY=

# Which Groq model to extract with. `gtm llmcheck` lists what your key can reach.
GTM_MODEL=llama-3.3-70b-versatile

# --- FlytBase Book of Business -------------------------------------------
# Source selection: fixture (local JSON) or flytbase (live API)
GTM_SOURCE=flytbase

# Origin only — no path, no trailing slash. Confirm the real endpoint shapes with:
#   uv run python -m gtm probe
FLYTBASE_BASE_URL=
FLYTBASE_API_KEY=

# Endpoint overrides — only set these if `probe` shows different paths.
# FLYTBASE_ACCOUNTS_PATH=/api/accounts
# FLYTBASE_DOCS_PATH=/api/accounts/{account_id}/documents
# FLYTBASE_USAGE_PATH=/api/accounts/{account_id}/usage
# FLYTBASE_DOC_DETAIL_PATH=/api/accounts/{account_id}/documents/{doc_id}

# --- Runtime --------------------------------------------------------------
GTM_DB_PATH=data/gtm.db
GTM_POLL_SECONDS=300
